# Mobile Development AI — environment variables
# Copy to `.env` for local `netlify dev`, and set the same keys in Netlify:
#   Site settings → Environment variables.
# NEVER commit real values. NEVER prefix secrets with VITE_ — VITE_* values are bundled into client JavaScript.

# ── Public (safe for the browser) ───────────────────────────────
# Only for GitHub Enterprise or the local mock (scripts/mock-github.ts). Leave unset for github.com.
# VITE_GITHUB_WEB_URL=http://127.0.0.1:8790

# ── Server-only secrets (Netlify Functions) ─────────────────────
# Public base URL of the site; used to build the OAuth redirect URL. Falls back to the request origin.
APP_URL=http://localhost:8888

# Phase 1 — GitHub OAuth App (https://github.com/settings/developers → OAuth Apps → New)
# Authorization callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Optional overrides for GitHub Enterprise or the local mock. Leave unset for github.com.
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com

# Phase 1 — 32+ characters used to derive the AES-GCM key that encrypts session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Phase 3 — 32-byte key (base64) used to encrypt user-supplied AI provider keys at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# Optional — PostgreSQL (e.g. Neon) for user + connection records. Run `npm run db:migrate` once.
# Sign-in works without it. Tokens are never stored in the database.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Optional — platform-level AI keys (users can also bring their own in Settings → AI Providers).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
