# Mobile Development AI — environment variables
# Copy to `.env` for local `netlify dev`, and set the same keys in Netlify:
#   Site settings → Environment variables.
# NEVER commit real values. NEVER prefix secrets with VITE_ — VITE_* values are bundled into client JavaScript.

# ── Public (safe for the browser) ───────────────────────────────
# Base URL of the deployed site, used to build OAuth redirect URLs.
VITE_APP_URL=http://localhost:8888

# ── Server-only secrets (Netlify Functions) ─────────────────────
# Phase 1 — GitHub OAuth App (https://github.com/settings/developers)
# Callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Phase 1 — 32+ random bytes used to sign/encrypt session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Phase 3 — 32-byte key (base64) used to encrypt user-supplied AI provider keys at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# Phase 1+ — PostgreSQL (e.g. Neon) for users, projects, task history.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Optional — platform-level AI keys (users can also bring their own in Settings → AI Providers).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
